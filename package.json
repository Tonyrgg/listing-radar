{
  "name": "listing-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:email-parser": "tsx scripts/smoke-email-parser.ts",
    "backup:data": "node --env-file=.env.local scripts/backup-data.mjs",
    "worker:check": "npm --prefix worker run worker:check",
    "worker:start": "npm --prefix worker run worker:start",
    "worker:start:assisted": "npm --prefix worker run worker:start:assisted",
    "worker:start:auto": "npm --prefix worker run worker:start:auto",
    "worker:resume": "npm --prefix worker run worker:resume --",
    "worker:desktop": "npm --prefix worker run desktop:dev",
    "worker:desktop:build": "npm --prefix worker run desktop:build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "imapflow": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^1.18.0",
    "mailparser": "^3.9.9",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
